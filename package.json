{
  "name": "axiom-ai",
  "displayName": "Axiom AI — Scaffold-Aware Developer Assistant",
  "description": "react-app-scaffold 기반 프론트엔드 개발 AI 어시스턴트 (폐쇄망 sLLM 연동)",
  "version": "0.1.0",
  "publisher": "axiom",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "axiom-ai-container",
          "title": "Axiom AI",
          "icon": "media/axiom-ai.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "axiom-ai-chat-container",
          "title": "Axiom AI Chat",
          "icon": "media/axiom-ai.svg"
        }
      ]
    },
    "views": {
      "axiom-ai-container": [
        {
          "type": "webview",
          "id": "axiom-ai.chatPanel",
          "name": "Axiom AI",
          "visibility": "visible"
        }
      ],
      "axiom-ai-chat-container": [
        {
          "type": "webview",
          "id": "axiom-ai.chatView",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Axiom AI",
      "properties": {
        "axiom-ai.llm.endpoint": {
          "type": "string",
          "default": "https://referral-aerial-than-mathematical.trycloudflare.com",
          "description": "LLM 서버 엔드포인트 URL (OpenAI 호환 API)"
        },
        "axiom-ai.llm.model": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "사용할 LLM 모델명"
        },
        "axiom-ai.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API 키 (로컬 서버 사용 시 빈 값으로 유지)"
        },
        "axiom-ai.llm.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "LLM 응답 온도 (0 = 결정적, 2 = 창의적)"
        },
        "axiom-ai.llm.maxTokens": {
          "type": "integer",
          "default": 4096,
          "minimum": 256,
          "description": "LLM 최대 출력 토큰 수"
        },
        "axiom-ai.rag.userRagFolder": {
          "type": "string",
          "default": "",
          "description": "추가 RAG 지식 폴더 경로 (절대 경로). 이 폴더의 모든 .md 파일이 임베딩 인덱스에 포함됩니다."
        },
        "axiom-ai.rag.additionalFiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "RAG 인덱스에 추가할 개별 .md 파일 경로 목록 (절대 경로)"
        },
        "axiom-ai.rag.externalCorpusEnabled": {
          "type": "boolean",
          "default": true,
          "description": "외부 사용자 corpus 폴더의 키워드 라우팅을 활성화합니다"
        },
        "axiom-ai.rag.validateExternalCorpus": {
          "type": "boolean",
          "default": true,
          "description": "외부 corpus frontmatter 유효성 검사 후 Output 채널에 경고를 표시합니다"
        }
      }
    },
    "commands": [
      {
        "command": "axiom-ai.openChat",
        "title": "Axiom AI: 채팅 창 열기",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "axiom-ai.clearHistory",
        "title": "Axiom AI: 대화 기록 초기화"
      },
      {
        "command": "axiom-ai.reindexCorpus",
        "title": "Axiom AI: Corpus 인덱스 재빌드"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "axiom-ai.openChat",
          "when": "view == axiom-ai.chatPanel",
          "group": "navigation"
        },
        {
          "command": "axiom-ai.clearHistory",
          "when": "view == axiom-ai.chatView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:corpus": "node scripts/build-corpus.mjs",
    "prebuild": "npm run build:corpus",
    "compile": "node esbuild.extension.js && node esbuild.webview.js",
    "watch": "concurrently \"node esbuild.extension.js --watch\" \"node esbuild.webview.js --watch\"",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.webview.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "~5.4.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.0.1"
  }
}
